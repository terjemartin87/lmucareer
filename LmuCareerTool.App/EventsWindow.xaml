<Window x:Class="LmuCareerTool.App.EventsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spesialarrangementer" Width="680" MinWidth="600"
        SizeToContent="Height" MaxHeight="820"
        Background="{StaticResource BgColor}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="24" LastChildFill="True">

        <Button DockPanel.Dock="Bottom" Content="Lukk" HorizontalAlignment="Right" Margin="0,16,0,0"
                Padding="20,10" Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click" />

        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="🏆 Spesialarrangementer" FontSize="22" FontFamily="Segoe UI Semibold" Margin="0,0,0,4" />
                <TextBlock Text="Ekte enduranceklassikere, helt separat fra sesongen din - teller ikke mot mesterskapet. Velg klasse og bil selv; systemet trekker vær når du melder deg på."
                           Foreground="{StaticResource MutedTextColor}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20" />

                <Border x:Name="ActiveEventCard" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="🟢 AKTIV PÅMELDING" Style="{StaticResource SectionHeaderStyle}" Foreground="{StaticResource GoodColor}" />
                        <TextBlock x:Name="ActiveEventText" Text="-" TextWrapping="Wrap" Margin="0,6,0,10" />
                        <TextBlock Text="Kjør denne runden i LMU for at den skal telle - eller trekk deg hvis du ikke skal fullføre den. Inngangspengene refunderes ikke."
                                   Foreground="{StaticResource MutedTextColor}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Button Content="Trekk deg" HorizontalAlignment="Left" Padding="14,8"
                                Style="{StaticResource SecondaryButtonStyle}" Foreground="{StaticResource DangerColor}" Click="WithdrawButton_Click" />
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="EventList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceColor}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold" FontSize="15" />
                                        <TextBlock Text="{Binding DetailText}" Foreground="{StaticResource MutedTextColor}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Meld på" VerticalAlignment="Center" Padding="14,10" Margin="14,0,0,0"
                                            IsEnabled="{Binding CanEnroll}" Click="EnrollButton_Click" Tag="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="HistoryHeaderText" Text="🏁 Fullførte arrangementer" Style="{StaticResource SectionHeaderStyle}" Margin="0,20,0,10" Visibility="Collapsed" />
                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceColor}" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Summary}" FontFamily="Segoe UI Semibold" />
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextColor}" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

<Window x:Class="LmuCareerTool.App.EventEnrollWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meld på" Width="440"
        SizeToContent="Height"
        Background="{StaticResource BgColor}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" Text="-" FontSize="20" FontFamily="Segoe UI Semibold" />
        <TextBlock x:Name="SubTitleText" Text="-" Foreground="{StaticResource MutedTextColor}" Margin="0,4,0,20" TextWrapping="Wrap" />

        <TextBlock Text="KLASSE" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
        <ComboBox x:Name="ClassComboBox" Padding="8,6" SelectionChanged="ClassComboBox_SelectionChanged" Margin="0,0,0,16" />

        <TextBlock Text="BIL" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
        <ComboBox x:Name="CarComboBox" Padding="8,6" Margin="0,0,0,16" />

        <TextBlock x:Name="WeatherNoteText" Text="Været trekkes tilfeldig når du melder deg på."
                   Foreground="{StaticResource MutedTextColor}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20" />

        <TextBlock x:Name="ErrorText" Text="" Foreground="{StaticResource DangerColor}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Avbryt" Padding="20,10" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click" Margin="0,0,10,0" />
            <Button x:Name="EnrollButton" Content="Meld på" Padding="20,10" Click="EnrollButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>

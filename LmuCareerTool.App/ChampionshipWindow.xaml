<Window x:Class="LmuCareerTool.App.ChampionshipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mesterskap" Width="760" Height="640" MinWidth="600" MinHeight="420"
        Background="{StaticResource BgColor}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" Text="Mesterskap" FontSize="22" FontFamily="Segoe UI Semibold" Margin="0,0,0,4" />
        <TextBlock x:Name="SubTitleText" DockPanel.Dock="Top" Text="-" Foreground="{StaticResource MutedTextColor}" Margin="0,0,0,16" TextWrapping="Wrap" />

        <Button DockPanel.Dock="Bottom" Content="Lukk" HorizontalAlignment="Right" Margin="0,16,0,0" Padding="20,10" Click="CloseButton_Click" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelColor}" CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Førermesterskap" FontFamily="Segoe UI Semibold" FontSize="14" Margin="6,4,0,10" />
                    <DataGrid x:Name="DriverGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="30" />
                            <DataGridTextColumn Header="" Binding="{Binding Trend}" Width="24" />
                            <DataGridTextColumn Header="Fører" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="130" />
                            <DataGridTextColumn Header="Poeng" Binding="{Binding Points}" Width="55" />
                            <DataGridTextColumn Header="Seire" Binding="{Binding Wins}" Width="50" />
                            <DataGridTextColumn Header="Podium" Binding="{Binding Podiums}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelColor}" CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Merkemesterskap" FontFamily="Segoe UI Semibold" FontSize="14" Margin="6,4,0,10" />
                    <DataGrid x:Name="ManufacturerGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="30" />
                            <DataGridTextColumn Header="Merke" Binding="{Binding Manufacturer}" Width="*" />
                            <DataGridTextColumn Header="Poeng" Binding="{Binding Points}" Width="55" />
                            <DataGridTextColumn Header="Seire" Binding="{Binding Wins}" Width="50" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>

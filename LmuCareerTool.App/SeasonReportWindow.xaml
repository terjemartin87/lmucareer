<Window x:Class="LmuCareerTool.App.SeasonReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sesongrapport" Width="820" MinWidth="700"
        SizeToContent="Height" MaxHeight="940"
        Background="{StaticResource BgColor}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="24" LastChildFill="True">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Lagre som bilde" Padding="14,10" Margin="0,0,8,0"
                    Background="{StaticResource PanelHoverColor}" Click="SaveImageButton_Click" />
            <Button Content="Lagre som HTML" Padding="14,10" Margin="0,0,8,0"
                    Background="{StaticResource PanelHoverColor}" Click="SaveHtmlButton_Click" />
            <Button x:Name="ContinueButton" Content="Fortsett" Padding="20,10" Click="ContinueButton_Click" />
        </StackPanel>

        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ReportContent" Background="{StaticResource BgColor}">
                <TextBlock x:Name="TitleText" Text="🏆 Sesong fullført!" FontSize="26" FontFamily="Segoe UI Semibold" Margin="0,0,0,4" />
                <TextBlock x:Name="SubTitleText" Text="-" Foreground="{StaticResource MutedTextColor}" Margin="0,0,0,16" />

                <ItemsControl x:Name="TileList" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelColor}" CornerRadius="10" Padding="14,10" Margin="0,0,10,10" MinWidth="110">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedTextColor}" FontSize="11" />
                                    <TextBlock Text="{Binding Value}" FontSize="20" FontFamily="Segoe UI Semibold" Foreground="{StaticResource AccentColor}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{StaticResource PanelColor}" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                    <TextBlock x:Name="ContractSummaryText" TextWrapping="Wrap" />
                </Border>

                <StackPanel x:Name="AwardsSection">
                    <TextBlock Text="SESONGPRISER" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,0,10" />
                    <ItemsControl x:Name="AwardsList" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelColor}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontFamily="Segoe UI Semibold" />
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextColor}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="RUNDE FOR RUNDE" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,0,10" />
                <Border Background="{StaticResource PanelColor}" CornerRadius="10" Padding="10" Margin="0,0,0,16" MaxHeight="220">
                    <DataGrid x:Name="RoundsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Runde" Binding="{Binding Round}" Width="55" />
                            <DataGridTextColumn Header="Bane" Binding="{Binding Track}" Width="*" />
                            <DataGridTextColumn Header="Resultat" Binding="{Binding Result}" Width="80" />
                            <DataGridTextColumn Header="Poeng" Binding="{Binding Points}" Width="60" />
                            <DataGridTextColumn Header="Tabell" Binding="{Binding TablePosition}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="FØRERMESTERSKAP" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,0,10" />
                        <Border Background="{StaticResource PanelColor}" CornerRadius="10" Padding="10" MaxHeight="260">
                            <DataGrid x:Name="DriverGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="32">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="24" Height="24" Margin="2">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="26" />
                                    <DataGridTextColumn Header="Fører" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Poeng" Binding="{Binding Points}" Width="50" />
                                    <DataGridTextColumn Header="Seire" Binding="{Binding Wins}" Width="45" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="MERKEMESTERSKAP" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,0,10" />
                        <Border Background="{StaticResource PanelColor}" CornerRadius="10" Padding="10" MaxHeight="260">
                            <DataGrid x:Name="ManufacturerGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="26" />
                                    <DataGridTextColumn Header="Merke" Binding="{Binding Manufacturer}" Width="*" />
                                    <DataGridTextColumn Header="Poeng" Binding="{Binding Points}" Width="50" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="TrackRecordsSection">
                    <TextBlock Text="PERSONLIGE REKORDER" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,0,10" />
                    <Border Background="{StaticResource PanelColor}" CornerRadius="10" Padding="10" MaxHeight="200">
                        <DataGrid x:Name="TrackRecordsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bane" Binding="{Binding Track}" Width="*" />
                                <DataGridTextColumn Header="Beste runde" Binding="{Binding BestLap}" Width="110" />
                                <DataGridTextColumn Header="" Binding="{Binding Badge}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

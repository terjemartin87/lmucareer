<Application x:Class="LmuCareerTool.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <SolidColorBrush x:Key="BgColor">#FF14161B</SolidColorBrush>
        <SolidColorBrush x:Key="PanelColor">#FF1E2129</SolidColorBrush>
        <SolidColorBrush x:Key="AccentColor">#FFE04B3C</SolidColorBrush>
        <SolidColorBrush x:Key="TextColor">#FFEDEDED</SolidColorBrush>
        <SolidColorBrush x:Key="MutedTextColor">#FF9AA0AC</SolidColorBrush>
        <SolidColorBrush x:Key="BorderColor">#FF2C303A</SolidColorBrush>
        <SolidColorBrush x:Key="GoodColor">#FF4CC38A</SolidColorBrush>
        <SolidColorBrush x:Key="WarnColor">#FFE0B23C</SolidColorBrush>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelColor}" />
            <Setter Property="Foreground" Value="{StaticResource TextColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

    </Application.Resources>
</Application>

<Window x:Class="LmuCareerTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LMU Karriere" Height="820" Width="1280"
        Background="{StaticResource BgColor}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Setup panel -->
            <RowDefinition Height="*" />    <!-- Main content -->
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Background="{StaticResource PanelColor}" CornerRadius="10" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="AvatarBorder" Width="64" Height="64" Margin="0,0,14,0" Cursor="Hand"
                            MouseLeftButtonUp="AvatarBorder_MouseLeftButtonUp" ToolTip="Se førerprofil">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.4" Color="Black" />
                        </Border.Effect>
                        <Ellipse Width="64" Height="64" Stroke="{StaticResource AccentColor}" StrokeThickness="1.5">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Border>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock x:Name="DriverNameText" Text="Fører: -" FontSize="22" FontFamily="Segoe UI Semibold" />
                        <TextBlock x:Name="ClassText" Text="Klasse: -" Foreground="{StaticResource MutedTextColor}" Margin="0,4,0,0" />
                        <TextBlock x:Name="ManufacturerText" Text="Merke: -" Foreground="{StaticResource MutedTextColor}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="NIVÅ" Foreground="{StaticResource MutedTextColor}" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock x:Name="LevelText" Text="1" FontSize="24" FontFamily="Segoe UI Semibold" Foreground="{StaticResource AccentColor}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="TOTAL XP" Foreground="{StaticResource MutedTextColor}" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock x:Name="XpText" Text="0" FontSize="24" FontFamily="Segoe UI Semibold" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="SESONGPOENG" Foreground="{StaticResource MutedTextColor}" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock x:Name="SeasonPointsText" Text="0" FontSize="24" FontFamily="Segoe UI Semibold" Foreground="{StaticResource GoodColor}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="RATING" Foreground="{StaticResource MutedTextColor}" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock x:Name="RatingText" Text="50" FontSize="24" FontFamily="Segoe UI Semibold" Foreground="#FF6FA8FF" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CREDITS" Foreground="{StaticResource MutedTextColor}" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock x:Name="CreditsText" Text="0" FontSize="24" FontFamily="Segoe UI Semibold" Foreground="{StaticResource WarnColor}" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== SETUP PANEL ===== -->
        <Border x:Name="SetupPanel" Grid.Row="1" Background="{StaticResource PanelColor}" CornerRadius="10" Padding="18" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Oppsett" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="LMU Results-mappe" Foreground="{StaticResource MutedTextColor}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox x:Name="ResultsFolderBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Ditt LMU-visningsnavn" Foreground="{StaticResource MutedTextColor}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox x:Name="PlayerNameBox" />
                    </StackPanel>
                    <Button x:Name="StartStopButton" Grid.Column="2" Content="Start overvåking" VerticalAlignment="Bottom" Click="StartStopButton_Click" />
                    <Button x:Name="ChampionshipButton" Grid.Column="3" Content="Mesterskap" VerticalAlignment="Bottom" Margin="8,0,0,0"
                            Background="{StaticResource PanelHoverColor}" Click="ChampionshipButton_Click" />
                </Grid>
                <TextBlock x:Name="StatusText" Text="Ikke startet." Foreground="{StaticResource MutedTextColor}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Season -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Next race callout -->
                <Border x:Name="NextRaceCard" Grid.Row="0" Background="#FF262A33" BorderBrush="{StaticResource AccentColor}" BorderThickness="1.5"
                        CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="NESTE LØP" Foreground="{StaticResource AccentColor}" FontSize="11" FontFamily="Segoe UI Semibold" />
                            <TextBlock x:Name="NextRaceTitle" Text="-" FontSize="18" FontFamily="Segoe UI Semibold" Margin="0,4,0,6" />
                            <TextBlock x:Name="NextRaceDetail" Text="-" TextWrapping="Wrap" Foreground="{StaticResource MutedTextColor}" />
                        </StackPanel>
                        <Button x:Name="CopyRecipeButton" Grid.Column="1" Content="Kopier oppskrift" VerticalAlignment="Top"
                                Margin="10,0,0,0" Padding="10,6" IsEnabled="False" Click="CopyRecipeButton_Click" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource PanelColor}" CornerRadius="10" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="SeasonHeaderText" Grid.Row="0" Text="Sesong" FontFamily="Segoe UI Semibold" FontSize="14" Margin="6,4,0,10" />
                        <DataGrid x:Name="SeasonGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" RowBackground="Transparent" AlternatingRowBackground="#FF20232B"
                                  GridLinesVisibility="None" HeadersVisibility="Column" CanUserAddRows="False" CanUserSortColumns="False"
                                  Foreground="{StaticResource TextColor}">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource MutedTextColor}" />
                                    <Setter Property="Padding" Value="6,6" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="6,8" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Runde" Binding="{Binding Round}" Width="55" />
                                <DataGridTextColumn Header="Bane" Binding="{Binding Track}" Width="*" />
                                <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="90" />
                                <DataGridTextColumn Header="Vær" Binding="{Binding Weather}" Width="150" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                <DataGridTextColumn Header="Resultat" Binding="{Binding Result}" Width="140" />
                                <DataGridTextColumn Header="Poeng" Binding="{Binding Points}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT: Log + history -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelColor}" CornerRadius="10" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Live-logg" FontFamily="Segoe UI Semibold" FontSize="14" Margin="6,4,0,10" />
                        <ListBox x:Name="LogListBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedTextColor}"
                                 FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource PanelColor}" CornerRadius="10" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Siste løp" FontFamily="Segoe UI Semibold" FontSize="14" Margin="6,4,0,0" />
                        <TextBlock DockPanel.Dock="Top" Text="Dobbeltklikk for detaljer (Practice/Qualifying/Race)" Foreground="{StaticResource MutedTextColor}" FontSize="11" Margin="6,0,0,10" />
                        <ListBox x:Name="HistoryListBox" Background="Transparent" BorderThickness="0" MouseDoubleClick="HistoryListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,6,6,6" Cursor="Hand">
                                        <TextBlock Text="{Binding Summary}" FontFamily="Segoe UI Semibold" />
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextColor}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

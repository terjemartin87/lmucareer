<Window x:Class="LmuCareerTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LMU Karriere" Height="860" Width="1400" MinHeight="640" MinWidth="1080"
        WindowState="Maximized"
        Background="{StaticResource BgColor}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== RACING STRIPE ===== -->
        <Border Grid.Row="0" Background="{StaticResource StripeBrush}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== VENSTRE NAVIGASJON ===== -->
            <Border Grid.Column="0" Background="{StaticResource NavColor}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,24,20,28">
                        <TextBlock Text="🏁 LMU" FontSize="20" FontFamily="Segoe UI Semibold" />
                        <TextBlock Text="KARRIERE" FontSize="12" Foreground="{StaticResource AccentColor}" FontFamily="Segoe UI Semibold" Margin="0,-2,0,0" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Text="v0.6" Foreground="{StaticResource DisabledTextColor}"
                               FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,16" />

                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="NavDashboard" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Content="🏠  Dashboard" IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSeason" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Content="📅  Sesong" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavChampionship" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Content="🏆  Mesterskap" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavHistory" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Content="📜  Historikk" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavHelp" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Content="❓  Hjelp" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Content="⚙  Innstillinger" Checked="Nav_Checked" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== INNHOLD ===== -->
            <Grid Grid.Column="1">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ===== HEADER (alltid synlig) ===== -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="AvatarBorder" Width="64" Height="64" Margin="0,0,14,0" Cursor="Hand"
                                        MouseLeftButtonUp="AvatarBorder_MouseLeftButtonUp" ToolTip="Se førerprofil">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.4" Color="Black" />
                                    </Border.Effect>
                                    <Ellipse Width="64" Height="64" Stroke="{StaticResource AccentColor}" StrokeThickness="1.5">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Border>
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                    <TextBlock x:Name="DriverNameText" Text="Fører: -" FontSize="20" FontFamily="Segoe UI Semibold" />
                                    <TextBlock x:Name="ClassText" Text="Klasse: -" Foreground="{StaticResource MutedTextColor}" Margin="0,4,0,0" FontSize="12" />
                                    <TextBlock x:Name="ManufacturerText" Text="Merke: -" Foreground="{StaticResource MutedTextColor}" Margin="0,2,0,0" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource StatTileStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="NIVÅ" Style="{StaticResource SectionHeaderStyle}" Margin="0" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="LevelText" Text="1" FontSize="22" FontFamily="Segoe UI Semibold" Foreground="{StaticResource AccentColor}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL XP" Style="{StaticResource SectionHeaderStyle}" Margin="0" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="XpText" Text="0" FontSize="22" FontFamily="Segoe UI Semibold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="SESONGPOENG" Style="{StaticResource SectionHeaderStyle}" Margin="0" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="SeasonPointsText" Text="0" FontSize="22" FontFamily="Segoe UI Semibold" Foreground="{StaticResource GoodColor}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="RATING" Style="{StaticResource SectionHeaderStyle}" Margin="0" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="RatingText" Text="50" FontSize="22" FontFamily="Segoe UI Semibold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="CREDITS" Style="{StaticResource SectionHeaderStyle}" Margin="0" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="CreditsText" Text="0" FontSize="22" FontFamily="Segoe UI Semibold" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ===== SIDE-VERT (Nav bytter hvilken som vises) ===== -->
                    <Grid Grid.Row="1">

                        <!-- DASHBOARD -->
                        <Grid x:Name="DashboardPanel" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border x:Name="NextRaceCard" Grid.Row="0" Background="{StaticResource SurfaceColor}"
                                    BorderBrush="{StaticResource AccentColor}" BorderThickness="1.5" CornerRadius="12"
                                    Padding="18" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.3" Color="#FFFF3B45" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="NESTE LØP" Foreground="{StaticResource AccentColor}" FontSize="11" FontFamily="Segoe UI Semibold" />
                                        <TextBlock x:Name="NextRaceTitle" Text="-" FontSize="20" FontFamily="Segoe UI Semibold" Margin="0,4,0,8" />
                                        <TextBlock x:Name="NextRaceDetail" Text="-" TextWrapping="Wrap" Foreground="{StaticResource MutedTextColor}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <Button x:Name="CopyRecipeButton" Content="📋 Kopier oppskrift" Padding="12,8" IsEnabled="False" Click="CopyRecipeButton_Click" />
                                        <Button x:Name="MiniWidgetButton" Content="🗗 Kompakt visning" Padding="12,8" Margin="0,8,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}" Click="MiniWidgetButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="LIVE-LOGG" Style="{StaticResource SectionHeaderStyle}" />
                                            <TextBlock Grid.Column="1" Text="❓ Hvordan fungerer dette?" Foreground="{StaticResource AccentBlue}"
                                                       FontSize="12" Cursor="Hand" MouseLeftButtonUp="HelpLink_MouseLeftButtonUp" />
                                        </Grid>
                                        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceColor}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="StatusIcon" Text="⏳" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="DashboardStatusText" Text="Fyll ut oppsett og trykk Start for å komme i gang."
                                                           Foreground="{StaticResource MutedTextColor}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ListBox x:Name="LogListBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedTextColor}"
                                                 FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                    </DockPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="SISTE LØP" Style="{StaticResource SectionHeaderStyle}" />
                                        <ListBox x:Name="RecentHistoryListBox" Background="Transparent" BorderThickness="0" MouseDoubleClick="HistoryListBox_MouseDoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="8,8,8,8" Cursor="Hand">
                                                        <TextBlock Text="{Binding Summary}" FontFamily="Segoe UI Semibold" FontSize="12" />
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextColor}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- SESONG -->
                        <Grid x:Name="SeasonPanel" Visibility="Collapsed">
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" x:Name="SeasonHeaderText" Text="SESONGKALENDER" Style="{StaticResource SectionHeaderStyle}" />
                                    <DataGrid Grid.Row="1" x:Name="SeasonGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Runde" Binding="{Binding Round}" Width="60" />
                                            <DataGridTextColumn Header="Bane" Binding="{Binding Track}" Width="*" />
                                            <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="100" />
                                            <DataGridTextColumn Header="Vær" Binding="{Binding Weather}" Width="160" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                                            <DataGridTextColumn Header="Resultat" Binding="{Binding Result}" Width="150" />
                                            <DataGridTextColumn Header="Poeng" Binding="{Binding Points}" Width="70" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- MESTERSKAP -->
                        <Grid x:Name="ChampionshipPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="ChampionshipSubTitleText" Text="Ingen aktiv sesong."
                                       Foreground="{StaticResource MutedTextColor}" Margin="0,0,0,16" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="FØRERMESTERSKAP" Style="{StaticResource SectionHeaderStyle}" />
                                        <DataGrid x:Name="DriverGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="" Width="34">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Ellipse Width="26" Height="26" Margin="2">
                                                                <Ellipse.Fill>
                                                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="30" />
                                                <DataGridTextColumn Header="" Binding="{Binding Trend}" Width="24" />
                                                <DataGridTextColumn Header="Fører" Binding="{Binding Name}" Width="*" />
                                                <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="140" />
                                                <DataGridTextColumn Header="Poeng" Binding="{Binding Points}" Width="60" />
                                                <DataGridTextColumn Header="Seire" Binding="{Binding Wins}" Width="55" />
                                                <DataGridTextColumn Header="Podium" Binding="{Binding Podiums}" Width="65" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="MERKEMESTERSKAP" Style="{StaticResource SectionHeaderStyle}" />
                                        <DataGrid x:Name="ManufacturerGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="30" />
                                                <DataGridTextColumn Header="Merke" Binding="{Binding Manufacturer}" Width="*" />
                                                <DataGridTextColumn Header="Poeng" Binding="{Binding Points}" Width="60" />
                                                <DataGridTextColumn Header="Seire" Binding="{Binding Wins}" Width="55" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- HISTORIKK -->
                        <Grid x:Name="HistoryPanel" Visibility="Collapsed">
                            <Border Style="{StaticResource CardStyle}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="HELE LØPSHISTORIKKEN" Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock DockPanel.Dock="Top" Text="Dobbeltklikk for detaljer (Practice/Qualifying/Race)"
                                               Foreground="{StaticResource MutedTextColor}" FontSize="11" Margin="0,0,0,10" />
                                    <ListBox x:Name="HistoryListBox" Background="Transparent" BorderThickness="0" MouseDoubleClick="HistoryListBox_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SurfaceColor}" CornerRadius="8" Padding="12" Margin="0,0,0,6" Cursor="Hand">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Summary}" FontFamily="Segoe UI Semibold" />
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextColor}" FontSize="12" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- HJELP -->
                        <Grid x:Name="HelpPanel" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="HVA ER DETTE?" Style="{StaticResource SectionHeaderStyle}" />
                                            <TextBlock TextWrapping="Wrap">
                                                LMU Karriere styrer <Run FontFamily="Segoe UI Semibold">ikke</Run> spillet - det kan ikke sette opp Race Weekend for deg.
                                                I stedet forteller det deg nøyaktig hva du skal sette opp (bane, bil, format, vær), du kjører løpet
                                                manuelt i LMU, og verktøyet oppdager automatisk resultatfilen etterpå og oppdaterer karrieren din:
                                                XP, poeng, mesterskapstabell, Rating, Credits og kontrakter.
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="SLIK SETTER DU OPP ET LØP" Style="{StaticResource SectionHeaderStyle}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Border Background="{StaticResource AccentColor}" CornerRadius="12" Width="24" Height="24" Margin="0,0,10,0">
                                                    <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Semibold" FontSize="12" />
                                                </Border>
                                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="I LMUs hovedmeny: velg 'Race Weekend' - IKKE Multiplayer. Kun Race Weekend bruker spillets faste WEC-startliste, som gjør et ekte mesterskap med faste rivaler mulig. Multiplayer-løp blir logget, men teller aldri mot karrieren." />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Border Background="{StaticResource AccentColor}" CornerRadius="12" Width="24" Height="24" Margin="0,0,10,0">
                                                    <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Semibold" FontSize="12" />
                                                </Border>
                                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="Match 'Neste løp'-kortet på Dashboard nøyaktig: klasse, bil (merket krever EN spesifikk bil for hele sesongen), bane og vær. Bruk 'Kopier oppskrift'-knappen for å ha alt ved siden av deg mens du setter opp." />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Border Background="{StaticResource AccentColor}" CornerRadius="12" Width="24" Height="24" Margin="0,0,10,0">
                                                    <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Semibold" FontSize="12" />
                                                </Border>
                                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="Kjør Practice/Qualifying/Race som normalt - antall AI-motstandere styres av spillets egne baneinnstillinger, ikke av verktøyet." />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{StaticResource GoodColor}" CornerRadius="12" Width="24" Height="24" Margin="0,0,10,0">
                                                    <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Semibold" FontSize="12" Foreground="#FF0B0D12" />
                                                </Border>
                                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="Ferdig! Så snart løpet er over, oppdager verktøyet den nye resultatfilen automatisk - du trenger ikke gjøre noe mer. Sjekk live-loggen på Dashboard." />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="HVIS OPPSETTET IKKE STEMMER" Style="{StaticResource SectionHeaderStyle}" />
                                            <TextBlock TextWrapping="Wrap">
                                                Kjørte du feil bane eller feil bil for sesongrunden? Verktøyet varsler deg med et gult ikon i loggen
                                                og et popup-vindu der du kan velge å <Run FontFamily="Segoe UI Semibold">godkjenne runden likevel</Run> -
                                                din egen karriere, dine egne regler. Sier du nei, kan du bare kjøre runden på nytt med riktig oppsett.
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="SYSTEMENE, KORT FORKLART" Style="{StaticResource SectionHeaderStyle}" />
                                            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"><Run FontFamily="Segoe UI Semibold" Foreground="{StaticResource AccentColor}">XP og Nivå</Run> - tjent per fullført sesongrunde. Nok XP låser opp nye klasser (GT3 → LMP3 → LMP2 → Hypercar).</TextBlock>
                                            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"><Run FontFamily="Segoe UI Semibold" Foreground="{StaticResource GoodColor}">Sesongpoeng</Run> - F1-poengskala (25-18-15...) per plassering. Din egen sammenlagtsum for sesongen, vist i Mesterskap-fanen sammen med resten av feltet.</TextBlock>
                                            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"><Run FontFamily="Segoe UI Semibold" Foreground="{StaticResource AccentBlue}">Rating</Run> - stiger av gode og rene resultater (0-100, start 50). Avgjør hvor interessert et merke er i deg.</TextBlock>
                                            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"><Run FontFamily="Segoe UI Semibold" Foreground="{StaticResource AccentGold}">Credits</Run> - spillvaluta tjent per løp + kontraktlønn. Brukes til bruddsummer og betalte privatlag-seter - aldri til å kjøpe deg en fabrikkontrakt du ikke har fortjent.</TextBlock>
                                            <TextBlock TextWrapping="Wrap"><Run FontFamily="Segoe UI Semibold">Kontrakter</Run> - se eget avsnitt under.</TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="TRANSFER-MARKEDET - HVOR KOMMER TILBUD FRA?" Style="{StaticResource SectionHeaderStyle}" />
                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                                Merkene sender IKKE tilbud midt i en sesong - de vurderer deg på to faste tidspunkt: når du starter en helt ny karriere, og hver gang en sesong er fullført. Hvert merke regner ut en interesse-score fra Rating din (mot merkets krav), hvordan forrige sesong gikk, og hvor rent du kjørte. Er du mer enn 10 Rating-poeng under kravet, vurderer de deg ikke i det hele tatt ennå.
                                            </TextBlock>
                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                                Har du allerede kontrakt med et merke og innfridde forrige sesongmål, får du en fornyelse i stedet for et nytt tilbud. Innfrir du IKKE målet, kan merket si deg opp. Uansett hvor dårlig det går, finnes alltid et betalt sete hos et privatlag som fallback (mot en engangskostnad, ingen lønn).
                                            </TextBlock>
                                            <Button x:Name="CheckInterestButton" Content="🔍 Sjekk merkeinteresse akkurat nå" HorizontalAlignment="Left"
                                                    Style="{StaticResource SecondaryButtonStyle}" Click="CheckInterestButton_Click" />
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- INNSTILLINGER -->
                        <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                            <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="OPPSETT" Style="{StaticResource SectionHeaderStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="LMU Results-mappe" Foreground="{StaticResource MutedTextColor}" FontSize="11" Margin="0,0,0,4" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ResultsFolderBox" Grid.Column="0" Margin="0,0,8,0" />
                                                <Button Grid.Column="1" Content="Bla gjennom..." Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="10,8" Click="BrowseResultsFolderButton_Click" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="Ditt LMU-visningsnavn" Foreground="{StaticResource MutedTextColor}" FontSize="11" Margin="0,0,0,4" />
                                            <TextBox x:Name="PlayerNameBox" />
                                        </StackPanel>
                                        <Button x:Name="StartStopButton" Grid.Column="2" Content="Start overvåking" VerticalAlignment="Bottom" Click="StartStopButton_Click" />
                                    </Grid>
                                    <TextBlock x:Name="StatusText" Text="Ikke startet." Foreground="{StaticResource MutedTextColor}" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ===== TOAST-VARSLER ===== -->
                <ItemsControl x:Name="ToastList" HorizontalAlignment="Right" VerticalAlignment="Top"
                              Margin="0,24,24,0" IsHitTestVisible="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceColor}" BorderBrush="{Binding AccentBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="14,12" Margin="0,0,0,10" MaxWidth="340">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.4" Color="Black" />
                                </Border.Effect>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="270" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>
</Window>

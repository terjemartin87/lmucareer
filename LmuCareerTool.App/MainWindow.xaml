<Window x:Class="LmuCareerTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LmuCareerTool.App.Localization"
        Title="{loc:Loc Main_WindowTitle}" Height="860" Width="1400" MinHeight="640" MinWidth="1080"
        WindowState="Maximized"
        Background="{StaticResource BgColor}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== RACING STRIPE ===== -->
        <Border Grid.Row="0" Background="{StaticResource StripeBrush}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== VENSTRE NAVIGASJON ===== -->
            <Border Grid.Column="0" Background="{StaticResource NavColor}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,20,20,20" HorizontalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="120" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Text="v0.6" Foreground="{StaticResource DisabledTextColor}"
                               FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,16" />

                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="NavDashboard" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Content="{loc:Loc Main_Nav_Dashboard}" IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSeason" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Content="{loc:Loc Main_Nav_Season}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavChampionship" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Content="{loc:Loc Main_Nav_Championship}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavHistory" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Content="{loc:Loc Main_Nav_History}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavHelp" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Content="{loc:Loc Main_Nav_Help}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Content="{loc:Loc Main_Nav_Settings}" Checked="Nav_Checked" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== INNHOLD ===== -->
            <Grid Grid.Column="1">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ===== HEADER (alltid synlig) ===== -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="AvatarBorder" Width="64" Height="64" Margin="0,0,14,0" Cursor="Hand"
                                        MouseLeftButtonUp="AvatarBorder_MouseLeftButtonUp" ToolTip="Se førerprofil">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.4" Color="Black" />
                                    </Border.Effect>
                                    <Ellipse Width="64" Height="64" Stroke="{StaticResource AccentColor}" StrokeThickness="1.5">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Border>
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                    <TextBlock x:Name="DriverNameText" Text="{loc:Loc Main_Header_DriverEmpty}" FontSize="20" FontFamily="Segoe UI Semibold" />
                                    <TextBlock x:Name="ClassText" Text="{loc:Loc Main_Header_ClassEmpty}" Foreground="{StaticResource MutedTextColor}" Margin="0,4,0,0" FontSize="12" />
                                    <TextBlock x:Name="ManufacturerText" Text="{loc:Loc Main_Header_MakeEmpty}" Foreground="{StaticResource MutedTextColor}" Margin="0,2,0,0" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource StatTileStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Main_Header_Level}" Style="{StaticResource SectionHeaderStyle}" Margin="0" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="LevelText" Text="1" FontSize="22" FontFamily="Segoe UI Semibold" Foreground="{StaticResource AccentColor}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Main_Header_TotalXp}" Style="{StaticResource SectionHeaderStyle}" Margin="0" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="XpText" Text="0" FontSize="22" FontFamily="Segoe UI Semibold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Main_Header_SeasonPoints}" Style="{StaticResource SectionHeaderStyle}" Margin="0" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="SeasonPointsText" Text="0" FontSize="22" FontFamily="Segoe UI Semibold" Foreground="{StaticResource GoodColor}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Main_Header_Rating}" Style="{StaticResource SectionHeaderStyle}" Margin="0" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="RatingText" Text="50" FontSize="22" FontFamily="Segoe UI Semibold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Main_Header_Credits}" Style="{StaticResource SectionHeaderStyle}" Margin="0" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="CreditsText" Text="0" FontSize="22" FontFamily="Segoe UI Semibold" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ===== SIDE-VERT (Nav bytter hvilken som vises) ===== -->
                    <Grid Grid.Row="1">

                        <!-- DASHBOARD -->
                        <Grid x:Name="DashboardPanel" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border x:Name="NextRaceCard" Grid.Row="0" Background="{StaticResource SurfaceColor}"
                                    BorderBrush="{StaticResource AccentColor}" BorderThickness="1.5" CornerRadius="12"
                                    Padding="18" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.3" Color="#FFFF3B45" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{loc:Loc Main_NextRace}" Foreground="{StaticResource AccentColor}" FontSize="11" FontFamily="Segoe UI Semibold" />
                                        <TextBlock x:Name="NextRaceTitle" Text="-" FontSize="20" FontFamily="Segoe UI Semibold" Margin="0,4,0,8" />
                                        <TextBlock x:Name="NextRaceDetail" Text="-" TextWrapping="Wrap" Foreground="{StaticResource MutedTextColor}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <Button x:Name="CopyRecipeButton" Content="{loc:Loc Main_CopyRecipeButton}" Padding="12,8" IsEnabled="False" Click="CopyRecipeButton_Click" />
                                        <Button x:Name="MiniWidgetButton" Content="{loc:Loc Main_MiniWidgetButton}" Padding="12,8" Margin="0,8,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}" Click="MiniWidgetButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:Loc Main_LiveLog}" Style="{StaticResource SectionHeaderStyle}" />
                                            <TextBlock Grid.Column="1" Text="{loc:Loc Main_HowDoesThisWork}" Foreground="{StaticResource AccentBlue}"
                                                       FontSize="12" Cursor="Hand" MouseLeftButtonUp="HelpLink_MouseLeftButtonUp" />
                                        </Grid>
                                        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceColor}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="StatusIcon" Text="⏳" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="DashboardStatusText" Text="{loc:Loc Main_DashboardStatusDefault}"
                                                           Foreground="{StaticResource MutedTextColor}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ListBox x:Name="LogListBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedTextColor}"
                                                 FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                    </DockPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Main_RecentRaces}" Style="{StaticResource SectionHeaderStyle}" />
                                        <ListBox x:Name="RecentHistoryListBox" Background="Transparent" BorderThickness="0" MouseDoubleClick="HistoryListBox_MouseDoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="8,8,8,8" Cursor="Hand">
                                                        <TextBlock Text="{Binding Summary}" FontFamily="Segoe UI Semibold" FontSize="12" />
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextColor}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- SESONG -->
                        <Grid x:Name="SeasonPanel" Visibility="Collapsed">
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" x:Name="SeasonHeaderText" Text="{loc:Loc Main_SeasonCalendar}" Style="{StaticResource SectionHeaderStyle}" />
                                    <DataGrid Grid.Row="1" x:Name="SeasonGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{loc:Loc Main_Col_Round}" Binding="{Binding Round}" Width="60" />
                                            <DataGridTextColumn Header="{loc:Loc Main_Col_Track}" Binding="{Binding Track}" Width="*" />
                                            <DataGridTextColumn Header="{loc:Loc Main_Col_Format}" Binding="{Binding Format}" Width="100" />
                                            <DataGridTextColumn Header="{loc:Loc Main_Col_Weather}" Binding="{Binding Weather}" Width="160" />
                                            <DataGridTextColumn Header="{loc:Loc Main_Col_Status}" Binding="{Binding Status}" Width="100" />
                                            <DataGridTextColumn Header="{loc:Loc Main_Col_Result}" Binding="{Binding Result}" Width="150" />
                                            <DataGridTextColumn Header="{loc:Loc Main_Col_Points}" Binding="{Binding Points}" Width="70" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- MESTERSKAP -->
                        <Grid x:Name="ChampionshipPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="ChampionshipSubTitleText" Text="{loc:Loc Main_ChampionshipNoSeason}"
                                       Foreground="{StaticResource MutedTextColor}" Margin="0,0,0,16" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Main_DriverChampionship}" Style="{StaticResource SectionHeaderStyle}" />
                                        <DataGrid x:Name="DriverGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="" Width="34">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Ellipse Width="26" Height="26" Margin="2">
                                                                <Ellipse.Fill>
                                                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="{loc:Loc Main_Col_Pos}" Binding="{Binding Position}" Width="30" />
                                                <DataGridTextColumn Header="" Binding="{Binding Trend}" Width="24" />
                                                <DataGridTextColumn Header="{loc:Loc Main_Col_Driver}" Binding="{Binding Name}" Width="*" />
                                                <DataGridTextColumn Header="{loc:Loc Main_Col_Team}" Binding="{Binding Team}" Width="140" />
                                                <DataGridTextColumn Header="{loc:Loc Main_Col_Points}" Binding="{Binding Points}" Width="60" />
                                                <DataGridTextColumn Header="{loc:Loc Main_Col_Wins}" Binding="{Binding Wins}" Width="55" />
                                                <DataGridTextColumn Header="{loc:Loc Main_Col_Podiums}" Binding="{Binding Podiums}" Width="65" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Main_ManufacturerChampionship}" Style="{StaticResource SectionHeaderStyle}" />
                                        <DataGrid x:Name="ManufacturerGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Loc Main_Col_Pos}" Binding="{Binding Position}" Width="30" />
                                                <DataGridTextColumn Header="{loc:Loc Main_Col_Manufacturer}" Binding="{Binding Manufacturer}" Width="*" />
                                                <DataGridTextColumn Header="{loc:Loc Main_Col_Points}" Binding="{Binding Points}" Width="60" />
                                                <DataGridTextColumn Header="{loc:Loc Main_Col_Wins}" Binding="{Binding Wins}" Width="55" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- HISTORIKK -->
                        <Grid x:Name="HistoryPanel" Visibility="Collapsed">
                            <Border Style="{StaticResource CardStyle}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Main_FullHistory}" Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Main_FullHistoryHelp}"
                                               Foreground="{StaticResource MutedTextColor}" FontSize="11" Margin="0,0,0,10" />
                                    <ListBox x:Name="HistoryListBox" Background="Transparent" BorderThickness="0" MouseDoubleClick="HistoryListBox_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SurfaceColor}" CornerRadius="8" Padding="12" Margin="0,0,0,6" Cursor="Hand">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Summary}" FontFamily="Segoe UI Semibold" />
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextColor}" FontSize="12" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- HJELP -->
                        <Grid x:Name="HelpPanel" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Main_Help_WhatIsThisHeader}" Style="{StaticResource SectionHeaderStyle}" />
                                            <TextBlock Text="{loc:Loc Main_Help_WhatIsThisBody}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Main_Help_SetupHeader}" Style="{StaticResource SectionHeaderStyle}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Border Background="{StaticResource AccentColor}" CornerRadius="12" Width="24" Height="24" Margin="0,0,10,0">
                                                    <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Semibold" FontSize="12" />
                                                </Border>
                                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:Loc Main_Help_Setup1}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Border Background="{StaticResource AccentColor}" CornerRadius="12" Width="24" Height="24" Margin="0,0,10,0">
                                                    <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Semibold" FontSize="12" />
                                                </Border>
                                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:Loc Main_Help_Setup2}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Border Background="{StaticResource AccentColor}" CornerRadius="12" Width="24" Height="24" Margin="0,0,10,0">
                                                    <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Semibold" FontSize="12" />
                                                </Border>
                                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:Loc Main_Help_Setup3}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{StaticResource GoodColor}" CornerRadius="12" Width="24" Height="24" Margin="0,0,10,0">
                                                    <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Semibold" FontSize="12" Foreground="#FF0B0D12" />
                                                </Border>
                                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:Loc Main_Help_Setup4}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Main_Help_MismatchHeader}" Style="{StaticResource SectionHeaderStyle}" />
                                            <TextBlock Text="{loc:Loc Main_Help_MismatchBody}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Main_Help_SystemsHeader}" Style="{StaticResource SectionHeaderStyle}" />
                                            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Text="{loc:Loc Main_Help_SystemsXp}" />
                                            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Text="{loc:Loc Main_Help_SystemsPoints}" />
                                            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Text="{loc:Loc Main_Help_SystemsRating}" />
                                            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Text="{loc:Loc Main_Help_SystemsCredits}" />
                                            <TextBlock TextWrapping="Wrap" Text="{loc:Loc Main_Help_SystemsContracts}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Main_Help_TransferHeader}" Style="{StaticResource SectionHeaderStyle}" />
                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Text="{loc:Loc Main_Help_TransferBody1}" />
                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Text="{loc:Loc Main_Help_TransferBody2}" />
                                            <Button x:Name="CheckInterestButton" Content="{loc:Loc Main_Help_CheckInterestButton}" HorizontalAlignment="Left"
                                                    Style="{StaticResource SecondaryButtonStyle}" Click="CheckInterestButton_Click" />
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- INNSTILLINGER -->
                        <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Top">
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Main_Settings_Setup}" Style="{StaticResource SectionHeaderStyle}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="{loc:Loc Main_Settings_ResultsFolder}" Foreground="{StaticResource MutedTextColor}" FontSize="11" Margin="0,0,0,4" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="ResultsFolderBox" Grid.Column="0" Margin="0,0,8,0" />
                                                    <Button Grid.Column="1" Content="{loc:Loc Common_Browse}" Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="10,8" Click="BrowseResultsFolderButton_Click" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock Text="{loc:Loc Main_Settings_PlayerName}" Foreground="{StaticResource MutedTextColor}" FontSize="11" Margin="0,0,0,4" />
                                                <TextBox x:Name="PlayerNameBox" />
                                            </StackPanel>
                                            <Button x:Name="StartStopButton" Grid.Column="2" Content="{loc:Loc Main_Settings_StartWatching}" VerticalAlignment="Bottom" Click="StartStopButton_Click" />
                                        </Grid>
                                        <TextBlock x:Name="StatusText" Text="{loc:Loc Main_Settings_StatusNotStarted}" Foreground="{StaticResource MutedTextColor}" Margin="0,14,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Common_LanguageLabel}" Style="{StaticResource SectionHeaderStyle}" />
                                        <ComboBox x:Name="LanguageBox" Width="200" HorizontalAlignment="Left" SelectionChanged="LanguageBox_SelectionChanged" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ===== TOAST-VARSLER ===== -->
                <ItemsControl x:Name="ToastList" HorizontalAlignment="Right" VerticalAlignment="Top"
                              Margin="0,24,24,0" IsHitTestVisible="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceColor}" BorderBrush="{Binding AccentBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="14,12" Margin="0,0,0,10" MaxWidth="340">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.4" Color="Black" />
                                </Border.Effect>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="270" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>
</Window>

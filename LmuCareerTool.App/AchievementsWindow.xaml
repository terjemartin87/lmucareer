<Window x:Class="LmuCareerTool.App.AchievementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prestasjoner" Width="640" MinWidth="560"
        SizeToContent="Height" MaxHeight="820"
        Background="{StaticResource BgColor}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="24" LastChildFill="True">

        <Button DockPanel.Dock="Bottom" Content="Lukk" HorizontalAlignment="Right" Margin="0,16,0,0"
                Padding="20,10" Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click" />

        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="🏆 Prestasjoner" FontSize="22" FontFamily="Segoe UI Semibold" Margin="0,0,0,4" />
                <TextBlock x:Name="SubTitleText" Text="-" Foreground="{StaticResource MutedTextColor}" TextWrapping="Wrap" Margin="0,0,0,20" />

                <ItemsControl x:Name="AchievementList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceColor}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <Grid Opacity="{Binding NameOpacity}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold" FontSize="15" />
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextColor}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{Binding BadgeColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BadgeText}" FontSize="10" Foreground="White" FontFamily="Segoe UI Semibold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

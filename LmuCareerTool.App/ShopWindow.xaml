<Window x:Class="LmuCareerTool.App.ShopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stab" Width="640" MinWidth="560"
        SizeToContent="Height" MaxHeight="820"
        Background="{StaticResource BgColor}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="24" LastChildFill="True">

        <Button DockPanel.Dock="Bottom" Content="Lukk" HorizontalAlignment="Right" Margin="0,16,0,0"
                Padding="20,10" Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click" />

        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="👔 Stab" FontSize="22" FontFamily="Segoe UI Semibold" Margin="0,0,0,4" />
                <TextBlock x:Name="SubTitleText" Text="-" Foreground="{StaticResource MutedTextColor}" TextWrapping="Wrap" Margin="0,0,0,20" />

                <ItemsControl x:Name="ShopList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceColor}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold" FontSize="15" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CostText}" Foreground="{StaticResource AccentGold}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextColor}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding ButtonText}" VerticalAlignment="Center" Padding="14,10" Margin="14,0,0,0"
                                            IsEnabled="{Binding CanBuy}" Click="BuyButton_Click" Tag="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

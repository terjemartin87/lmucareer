<Window x:Class="LmuCareerTool.App.ManufacturerInterestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merkeinteresse" Width="600" MinWidth="520"
        SizeToContent="Height" MaxHeight="820"
        Background="{StaticResource BgColor}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="24" LastChildFill="True">

        <Button DockPanel.Dock="Bottom" Content="Lukk" HorizontalAlignment="Right" Margin="0,16,0,0"
                Padding="20,10" Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click" />

        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="🔍 Merkeinteresse akkurat nå" FontSize="22" FontFamily="Segoe UI Semibold" Margin="0,0,0,4" />
                <TextBlock x:Name="SubTitleText" Text="-" Foreground="{StaticResource MutedTextColor}" TextWrapping="Wrap" Margin="0,0,0,4" />
                <TextBlock Text="Dette er kun en forhåndsvisning basert på Rating og forrige sesong - du velger og signerer først når du starter en ny sesong."
                           Foreground="{StaticResource WarnColor}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20" />

                <TextBlock x:Name="NoOffersText" Text="Ingen merker er interessert ennå - kjør noen rene, gode løp for å øke Rating din."
                           Foreground="{StaticResource MutedTextColor}" Visibility="Collapsed" Margin="0,0,0,8" TextWrapping="Wrap" />

                <ItemsControl x:Name="OfferList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceColor}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontFamily="Segoe UI Semibold" FontSize="15" VerticalAlignment="Center" />
                                        <Border Background="{StaticResource AccentColor}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BadgeText}" FontSize="10" Foreground="White" FontFamily="Segoe UI Semibold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedTextColor}" FontSize="12" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ReasoningText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding LengthText}" Foreground="{StaticResource MutedTextColor}" FontSize="12" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding SalaryText}" Foreground="{StaticResource GoodColor}" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding GoalText}" Foreground="{StaticResource WarnColor}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

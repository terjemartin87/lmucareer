<Window x:Class="LmuCareerTool.App.ModeSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LmuCareerTool.App.Localization"
        Title="{loc:Loc ModeSelect_WindowTitle}" Width="560" SizeToContent="Height"
        Background="{StaticResource BgColor}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource StripeBrush}" />

        <StackPanel Grid.Row="1" Margin="40,36,40,40">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,-16">
                <RadioButton x:Name="LangNoButton" GroupName="Lang" Content="NO" Margin="0,0,10,0"
                             Checked="LangNoButton_Checked" />
                <RadioButton x:Name="LangEnButton" GroupName="Lang" Content="EN" Checked="LangEnButton_Checked" />
            </StackPanel>

            <Image Source="/Assets/logo.png" Width="160" HorizontalAlignment="Center" Margin="0,0,0,10" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Color="Black" />
                </Image.Effect>
            </Image>
            <TextBlock Text="{loc:Loc ModeSelect_Quote}" FontStyle="Italic"
                       Foreground="{StaticResource MutedTextColor}" HorizontalAlignment="Center" Margin="0,4,0,8" />

            <TextBlock Text="{loc:Loc ModeSelect_SelectMode}" Style="{StaticResource SectionHeaderStyle}" Margin="0,30,0,14" HorizontalAlignment="Center" />

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Cursor="Hand" MouseLeftButtonUp="CareerCard_Click">
                <StackPanel>
                    <TextBlock Text="{loc:Loc ModeSelect_CareerTitle}" FontSize="17" FontFamily="Segoe UI Semibold" />
                    <TextBlock Text="{loc:Loc ModeSelect_CareerDesc}"
                               Foreground="{StaticResource MutedTextColor}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,10" />
                    <Button Content="{loc:Loc ModeSelect_CareerButton}" Click="CareerCard_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonUp="LeagueCard_Click">
                <StackPanel>
                    <TextBlock Text="{loc:Loc ModeSelect_LeagueTitle}" FontSize="17" FontFamily="Segoe UI Semibold" />
                    <TextBlock Text="{loc:Loc ModeSelect_LeagueDesc}"
                               Foreground="{StaticResource MutedTextColor}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,10" />
                    <Button Content="{loc:Loc ModeSelect_LeagueButton}" Style="{StaticResource SecondaryButtonStyle}" Click="LeagueCard_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>

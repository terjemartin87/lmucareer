<Window x:Class="LmuCareerTool.App.MiniWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neste løp" Width="320" SizeToContent="Height"
        Background="{StaticResource BgColor}"
        WindowStyle="ToolWindow" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource StripeBrush}" />

        <StackPanel Grid.Row="1" Margin="16">
            <TextBlock Text="NESTE LØP" Foreground="{StaticResource AccentColor}" FontSize="11" FontFamily="Segoe UI Semibold" />
            <TextBlock x:Name="TitleText" Text="-" FontSize="17" FontFamily="Segoe UI Semibold" Margin="0,4,0,8" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailText" Text="-" Foreground="{StaticResource MutedTextColor}" TextWrapping="Wrap" FontSize="12" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Border Style="{StaticResource StatTileStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="RATING" FontSize="10" Foreground="{StaticResource MutedTextColor}" />
                        <TextBlock x:Name="RatingText" Text="-" FontSize="16" FontFamily="Segoe UI Semibold" Foreground="{StaticResource AccentBlue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTileStyle}">
                    <StackPanel>
                        <TextBlock Text="CREDITS" FontSize="10" Foreground="{StaticResource MutedTextColor}" />
                        <TextBlock x:Name="CreditsText" Text="-" FontSize="16" FontFamily="Segoe UI Semibold" Foreground="{StaticResource AccentGold}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

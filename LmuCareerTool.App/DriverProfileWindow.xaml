<Window x:Class="LmuCareerTool.App.DriverProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Førerprofil" Width="620" MinWidth="560"
        SizeToContent="Height" MaxHeight="820"
        Background="{StaticResource BgColor}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="24" LastChildFill="True">

        <Button DockPanel.Dock="Bottom" Content="Lukk" HorizontalAlignment="Right" Margin="0,16,0,0" Style="{StaticResource SecondaryButtonStyle}"
                Padding="20,10" Click="CloseButton_Click" />

        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Width="140" Height="140" Margin="0,0,20,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="Black" />
                        </Border.Effect>
                        <Ellipse Width="140" Height="140" Stroke="{StaticResource AccentColor}" StrokeThickness="2.5">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="DriverNameText" Text="-" FontSize="26" FontFamily="Segoe UI Semibold" />
                        <TextBlock x:Name="ContractText" Text="-" Foreground="{StaticResource MutedTextColor}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="360" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="KARRIERESTATISTIKK" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,0,10" />
                <ItemsControl x:Name="StatList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelColor}" CornerRadius="10" Padding="14,10" Margin="0,0,10,10" MinWidth="120">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedTextColor}" FontSize="11" />
                                    <TextBlock Text="{Binding Value}" FontSize="20" FontFamily="Segoe UI Semibold" Foreground="{StaticResource AccentColor}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

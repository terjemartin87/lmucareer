<Window x:Class="LmuCareerTool.App.RaceDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Løpsdetaljer" Height="560" Width="520"
        Background="{StaticResource BgColor}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TrackText" Text="-" FontSize="22" FontFamily="Segoe UI Semibold" />
            <TextBlock x:Name="SubText" Text="-" Foreground="{StaticResource MutedTextColor}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="PRACTICE" FontFamily="Segoe UI Semibold" Foreground="{StaticResource MutedTextColor}" FontSize="12" Margin="0,0,0,8" />
                <TextBlock x:Name="PracticeText" Text="-" FontFamily="Consolas" FontSize="14" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="QUALIFYING" FontFamily="Segoe UI Semibold" Foreground="{StaticResource MutedTextColor}" FontSize="12" Margin="0,0,0,8" />
                <TextBlock x:Name="QualifyingText" Text="-" FontFamily="Consolas" FontSize="14" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="RACE" FontFamily="Segoe UI Semibold" Foreground="{StaticResource AccentColor}" FontSize="12" Margin="0,0,0,8" />
                <TextBlock x:Name="RaceText" Text="-" FontFamily="Consolas" FontSize="14" />
            </StackPanel>
        </Border>

        <Button Grid.Row="4" Content="Lukk" HorizontalAlignment="Right" Padding="20,10" Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click" />
    </Grid>
</Window>

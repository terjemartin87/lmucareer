<Window x:Class="LmuCareerTool.App.LeagueMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LmuCareerTool.App.Localization"
        Title="{loc:Loc League_WindowTitle}" Height="860" Width="1400" MinHeight="640" MinWidth="1080"
        WindowState="Maximized"
        Background="{StaticResource BgColor}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource StripeBrush}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== VENSTRE NAVIGASJON ===== -->
            <Border Grid.Column="0" Background="{StaticResource NavColor}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,24,20,28">
                        <TextBlock Text="{loc:Loc League_LogoLine1}" FontSize="20" FontFamily="Segoe UI Semibold" />
                        <TextBlock x:Name="LeagueNameNavText" Text="{loc:Loc League_LogoLineDefault}" FontSize="12" Foreground="{StaticResource AccentBlue}" FontFamily="Segoe UI Semibold" Margin="0,-2,0,0" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="NavDashboard" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Content="{loc:Loc League_Nav_Dashboard}" IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavStandings" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Content="{loc:Loc League_Nav_Standings}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavCalendar" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Content="{loc:Loc League_Nav_Calendar}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavPenalties" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Content="{loc:Loc League_Nav_Penalties}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Content="{loc:Loc League_Nav_Settings}" Checked="Nav_Checked" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== INNHOLD ===== -->
            <Grid Grid.Column="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== HEADER ===== -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderLeagueNameText" Text="{loc:Loc League_HeaderLeagueNameEmpty}" FontSize="20" FontFamily="Segoe UI Semibold" />
                            <TextBlock x:Name="HeaderSeasonText" Text="{loc:Loc League_HeaderNoSeasonGenerate}" Foreground="{StaticResource MutedTextColor}" Margin="0,4,0,0" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource StatTileStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc League_Rounds}" Style="{StaticResource SectionHeaderStyle}" Margin="0" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="RoundsText" Text="0 / 0" FontSize="20" FontFamily="Segoe UI Semibold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc League_Leader}" Style="{StaticResource SectionHeaderStyle}" Margin="0" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="LeaderText" Text="-" FontSize="16" FontFamily="Segoe UI Semibold" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== SIDE-VERT ===== -->
                <Grid Grid.Row="1">

                    <!-- DASHBOARD -->
                    <Grid x:Name="DashboardPanel" Visibility="Visible">
                        <Border Style="{StaticResource CardStyle}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Main_LiveLog}" Style="{StaticResource SectionHeaderStyle}" />
                                <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceColor}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="StatusIcon" Text="⏳" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DashboardStatusText" Text="{loc:Loc League_DashboardStatusDefault}"
                                                   Foreground="{StaticResource MutedTextColor}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ListBox x:Name="LogListBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedTextColor}"
                                         FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- STILLING -->
                    <Grid x:Name="StandingsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                                x:Name="ClassFilterCard" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc League_ClassLabel}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc League_ClassHelp}"
                                           Foreground="{StaticResource MutedTextColor}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <ComboBox x:Name="ClassFilterBox" Width="180" SelectionChanged="ClassFilterBox_SelectionChanged" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Main_DriverChampionship}" Style="{StaticResource SectionHeaderStyle}" />
                                    <DataGrid x:Name="DriverGrid" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="DriverGrid_MouseDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{loc:Loc Main_Col_Pos}" Binding="{Binding Position}" Width="30" />
                                            <DataGridTextColumn Header="{loc:Loc Main_Col_Driver}" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="{loc:Loc Main_Col_Team}" Binding="{Binding Team}" Width="140" />
                                            <DataGridTextColumn Header="{loc:Loc Main_Col_Points}" Binding="{Binding Points}" Width="60" />
                                            <DataGridTextColumn Header="{loc:Loc Main_Col_Wins}" Binding="{Binding Wins}" Width="55" />
                                            <DataGridTextColumn Header="{loc:Loc Main_Col_Podiums}" Binding="{Binding Podiums}" Width="65" />
                                            <DataGridTextColumn Header="{loc:Loc League_Col_Top5}" Binding="{Binding Top5}" Width="55" />
                                            <DataGridTextColumn Header="{loc:Loc League_Col_Top10}" Binding="{Binding Top10}" Width="60" />
                                            <DataGridTextColumn Header="{loc:Loc League_Col_Penalty}" Binding="{Binding PenaltyPoints}" Width="60" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Main_ManufacturerChampionship}" Style="{StaticResource SectionHeaderStyle}" />
                                    <DataGrid x:Name="ManufacturerGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{loc:Loc Main_Col_Pos}" Binding="{Binding Position}" Width="30" />
                                            <DataGridTextColumn Header="{loc:Loc Main_Col_Manufacturer}" Binding="{Binding Manufacturer}" Width="*" />
                                            <DataGridTextColumn Header="{loc:Loc Main_Col_Points}" Binding="{Binding Points}" Width="60" />
                                            <DataGridTextColumn Header="{loc:Loc Main_Col_Wins}" Binding="{Binding Wins}" Width="55" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- KALENDER -->
                    <Grid x:Name="CalendarPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{loc:Loc League_RaceCalendar}" Style="{StaticResource SectionHeaderStyle}" />
                                <DataGrid x:Name="CalendarGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Loc Main_Col_Round}" Binding="{Binding Round}" Width="60" />
                                        <DataGridTextColumn Header="{loc:Loc Main_Col_Track}" Binding="{Binding Track}" Width="*" />
                                        <DataGridTextColumn Header="{loc:Loc Main_Col_Format}" Binding="{Binding Format}" Width="100" />
                                        <DataGridTextColumn Header="{loc:Loc Main_Col_Status}" Binding="{Binding Status}" Width="100" />
                                        <DataGridTextColumn Header="{loc:Loc League_Col_Winner}" Binding="{Binding Winner}" Width="180" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- STRAFFER -->
                    <Grid x:Name="PenaltiesPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{loc:Loc League_PenaltiesGiven}" Style="{StaticResource SectionHeaderStyle}" />
                                <DataGrid x:Name="PenaltyGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Loc Main_Col_Round}" Binding="{Binding Round}" Width="60" />
                                        <DataGridTextColumn Header="{loc:Loc Main_Col_Driver}" Binding="{Binding Driver}" Width="160" />
                                        <DataGridTextColumn Header="{loc:Loc League_Col_Consequence}" Binding="{Binding Consequence}" Width="120" />
                                        <DataGridTextColumn Header="{loc:Loc League_Col_Reason}" Binding="{Binding Reason}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc League_GiveNewPenalty}" Style="{StaticResource SectionHeaderStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Main_Col_Round}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextColor}" />
                                    <ComboBox x:Name="PenaltyRoundBox" Grid.Column="1" Margin="0,0,16,0" />
                                    <TextBlock Grid.Column="2" Text="{loc:Loc Main_Col_Driver}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextColor}" />
                                    <ComboBox x:Name="PenaltyDriverBox" Grid.Column="3" Margin="0,0,16,0" IsEditable="True" />
                                    <TextBlock Grid.Column="4" Text="{loc:Loc League_PointsDeduction}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextColor}" />
                                    <TextBox x:Name="PenaltyPointsBox" Grid.Column="5" Text="0" />
                                </Grid>
                                <TextBlock Text="{loc:Loc League_Col_Reason}" Foreground="{StaticResource MutedTextColor}" FontSize="11" Margin="0,12,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PenaltyReasonBox" Grid.Column="0" Margin="0,0,16,0" />
                                    <CheckBox x:Name="PenaltyDsqBox" Grid.Column="1" Content="{loc:Loc League_Disqualify}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                </Grid>
                                <Button Content="{loc:Loc League_GivePenaltyButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="14,8" Click="ApplyPenaltyButton_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- INNSTILLINGER -->
                    <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc League_Settings_Monitoring}" Style="{StaticResource SectionHeaderStyle}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="{loc:Loc Main_Settings_ResultsFolder}" Foreground="{StaticResource MutedTextColor}" FontSize="11" Margin="0,0,0,4" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="ResultsFolderBox" Grid.Column="0" Margin="0,0,8,0" />
                                                    <Button Grid.Column="1" Content="{loc:Loc Common_Browse}" Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="10,8" Click="BrowseResultsFolderButton_Click" />
                                                </Grid>
                                            </StackPanel>
                                            <Button x:Name="StartStopButton" Grid.Column="1" Content="{loc:Loc Main_Settings_StartWatching}" VerticalAlignment="Bottom" Click="StartStopButton_Click" />
                                        </Grid>
                                        <TextBlock x:Name="StatusText" Text="{loc:Loc Main_Settings_StatusNotStarted}" Foreground="{StaticResource MutedTextColor}" Margin="0,14,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc League_Settings_GenerateSeason}" Style="{StaticResource SectionHeaderStyle}" />
                                        <TextBlock Text="{loc:Loc League_Settings_GenerateSeasonHelp}"
                                                   Foreground="{StaticResource MutedTextColor}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />

                                        <TextBlock Text="{loc:Loc League_Settings_ClassesLabel}"
                                                   Foreground="{StaticResource MutedTextColor}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <ItemsControl x:Name="CarClassList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,18,10" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="{loc:Loc League_Settings_RoundCount}" Foreground="{StaticResource MutedTextColor}" FontSize="11" Margin="0,0,0,4" />
                                                <TextBox x:Name="RoundCountBox" Text="8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{loc:Loc Main_Col_Format}" Foreground="{StaticResource MutedTextColor}" FontSize="11" Margin="0,0,0,4" />
                                                <ComboBox x:Name="FormatBox" />
                                            </StackPanel>
                                        </Grid>
                                        <Button Content="{loc:Loc League_Settings_GenerateButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="14,8" Click="GenerateSeasonButton_Click" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc League_Settings_ShareTitle}" Style="{StaticResource SectionHeaderStyle}" />
                                        <TextBlock Text="{loc:Loc League_Settings_ShareBody}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextColor}" FontSize="12" Margin="0,0,0,10" />
                                        <Button Content="{loc:Loc League_Settings_PublishButton}" HorizontalAlignment="Left" Padding="14,8"
                                                Style="{StaticResource SecondaryButtonStyle}" Click="PublishButton_Click" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Common_LanguageLabel}" Style="{StaticResource SectionHeaderStyle}" />
                                        <ComboBox x:Name="LanguageBox" Width="200" HorizontalAlignment="Left" SelectionChanged="LanguageBox_SelectionChanged" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

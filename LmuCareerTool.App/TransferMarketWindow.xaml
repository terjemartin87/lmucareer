<Window x:Class="LmuCareerTool.App.TransferMarketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfermarked" Width="640" MinWidth="560"
        SizeToContent="Height" MaxHeight="820"
        Background="{StaticResource BgColor}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="24" LastChildFill="True">

        <Button DockPanel.Dock="Bottom" Content="Lukk" HorizontalAlignment="Right" Margin="0,16,0,0"
                Padding="20,10" Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click" />

        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="🏭 Transfermarked" FontSize="22" FontFamily="Segoe UI Semibold" Margin="0,0,0,4" />
                <TextBlock x:Name="SubTitleText" Text="-" Foreground="{StaticResource MutedTextColor}" TextWrapping="Wrap" Margin="0,0,0,4" />
                <TextBlock Text="Alle merker i klassen din - også de som ikke er interesserte ennå, slik at du ser hva som mangler. Interessen er merkets 'hukommelse' av deg og beveger seg gradvis, ikke momentant."
                           Foreground="{StaticResource WarnColor}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20" />

                <TextBlock x:Name="NoManufacturersText" Text="Denne klassen har ikke et merke-kontraktsystem ennå."
                           Foreground="{StaticResource MutedTextColor}" Visibility="Collapsed" Margin="0,0,0,8" TextWrapping="Wrap" />

                <ItemsControl x:Name="ManufacturerList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceColor}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold" FontSize="15" VerticalAlignment="Center" />
                                        <Border Background="{Binding BadgeColor}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BadgeText}" FontSize="10" Foreground="White" FontFamily="Segoe UI Semibold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding InterestText}" Foreground="{StaticResource MutedTextColor}" FontSize="12" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding GapText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

<Window x:Class="LmuCareerTool.App.SeasonSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sesong fullført" Width="640" MinWidth="560"
        SizeToContent="Height" MaxHeight="920"
        Background="{StaticResource BgColor}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="24" LastChildFill="True">

        <Button DockPanel.Dock="Bottom" x:Name="StartButton" Content="Start ny sesong" HorizontalAlignment="Right"
                Padding="20,10" Margin="0,16,0,0" Click="StartButton_Click" />

        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="🏆 Sesong fullført!" FontSize="24" FontFamily="Segoe UI Semibold" Margin="0,0,0,4" />
                <TextBlock x:Name="SubTitleText" Text="-" Foreground="{StaticResource MutedTextColor}" Margin="0,0,0,16" TextWrapping="Wrap" />

                <Border x:Name="ResultsBorder" Background="{StaticResource PanelColor}" CornerRadius="10" Padding="12" Margin="0,0,0,16" MaxHeight="180">
                    <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Runde" Binding="{Binding Round}" Width="55" />
                            <DataGridTextColumn Header="Bane" Binding="{Binding Track}" Width="*" />
                            <DataGridTextColumn Header="Resultat" Binding="{Binding Result}" Width="90" />
                            <DataGridTextColumn Header="Poeng" Binding="{Binding Points}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Background="{StaticResource PanelColor}" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1. VELG KLASSE" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,0,10" />
                        <ComboBox x:Name="ClassComboBox" Padding="8,6" SelectionChanged="ClassComboBox_SelectionChanged" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelColor}" CornerRadius="10" Padding="16" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="2. GARASJE - velg merke (Rating og Credits avgjør hva som er tilgjengelig)" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,0,10" TextWrapping="Wrap" />
                        <TextBlock x:Name="NoManufacturersText" Text="Denne klassen har ingen merke-valg - bilen trekkes tilfeldig." Foreground="{StaticResource MutedTextColor}" Visibility="Collapsed" Margin="0,0,0,8" />
                        <ItemsControl x:Name="ManufacturerList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF20232B" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <RadioButton GroupName="Manufacturer" IsEnabled="{Binding Unlocked}"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                         VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold" />
                                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextColor}" FontSize="12" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="{Binding BuyText}" Tag="{Binding Name}" Click="BuyButton_Click"
                                                    Visibility="{Binding ShowBuyButton, Converter={StaticResource BoolToVis}}"
                                                    IsEnabled="{Binding CanAfford}" Padding="10,6" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

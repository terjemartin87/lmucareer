<Window x:Class="LmuCareerTool.App.SeasonSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sesong fullført" Height="760" Width="640"
        Background="{StaticResource BgColor}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Text="🏆 Sesong fullført!" FontSize="24" FontFamily="Segoe UI Semibold" Margin="0,0,0,4" />
        <TextBlock x:Name="SubTitleText" Grid.Row="1" Text="-" Foreground="{StaticResource MutedTextColor}" Margin="0,0,0,16" TextWrapping="Wrap" />

        <Border x:Name="ResultsBorder" Grid.Row="2" Background="{StaticResource PanelColor}" CornerRadius="10" Padding="12" Margin="0,0,0,16" MaxHeight="180">
            <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0" RowBackground="Transparent" AlternatingRowBackground="#FF20232B"
                      GridLinesVisibility="None" HeadersVisibility="Column" CanUserAddRows="False" CanUserSortColumns="False"
                      Foreground="{StaticResource TextColor}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource MutedTextColor}" />
                        <Setter Property="Padding" Value="6,6" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="6,6" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Runde" Binding="{Binding Round}" Width="55" />
                    <DataGridTextColumn Header="Bane" Binding="{Binding Track}" Width="*" />
                    <DataGridTextColumn Header="Resultat" Binding="{Binding Result}" Width="90" />
                    <DataGridTextColumn Header="Poeng" Binding="{Binding Points}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource PanelColor}" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="1. VELG KLASSE" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,0,10" />
                <ComboBox x:Name="ClassComboBox" Padding="8,6" SelectionChanged="ClassComboBox_SelectionChanged" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource PanelColor}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="2. GARASJE - velg merke (Rating og Credits avgjør hva som er tilgjengelig)" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,0,10" TextWrapping="Wrap" />
                <TextBlock x:Name="NoManufacturersText" Text="Denne klassen har ingen merke-valg - bilen trekkes tilfeldig." Foreground="{StaticResource MutedTextColor}" Visibility="Collapsed" Margin="0,0,0,8" />
                <ItemsControl x:Name="ManufacturerList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FF20232B" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton GroupName="Manufacturer" Tag="{Binding Name}" IsEnabled="{Binding Unlocked}"
                                                 Checked="ManufacturerRadio_Checked" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold" />
                                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextColor}" FontSize="12" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding BuyText}" Tag="{Binding Name}" Click="BuyButton_Click"
                                            Visibility="{Binding ShowBuyButton, Converter={StaticResource BoolToVis}}"
                                            IsEnabled="{Binding CanAfford}" Padding="10,6" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Button Grid.Row="5" x:Name="StartButton" Content="Start ny sesong" HorizontalAlignment="Right"
                Padding="20,10" Click="StartButton_Click" />
    </Grid>
</Window>

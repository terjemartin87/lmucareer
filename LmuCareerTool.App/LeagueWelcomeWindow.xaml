<Window x:Class="LmuCareerTool.App.LeagueWelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LMU Karriere - Liga" Width="520" SizeToContent="Height"
        Background="{StaticResource BgColor}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource StripeBrush}" />

        <StackPanel Grid.Row="1" Margin="40,36,40,40">
            <TextBlock Text="🏆 LIGA MODUS" FontSize="26" FontFamily="Segoe UI Semibold" HorizontalAlignment="Center" />
            <TextBlock Text="Kjør et hostet mesterskap mot ekte motstandere." FontStyle="Italic"
                       Foreground="{StaticResource MutedTextColor}" HorizontalAlignment="Center" Margin="0,4,0,8" />

            <TextBlock x:Name="WelcomeBackText" Text="" FontSize="13" Foreground="{StaticResource GoodColor}"
                       FontFamily="Segoe UI Semibold" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" />

            <Border Style="{StaticResource CardStyle}" Margin="0,28,0,14">
                <StackPanel>
                    <TextBlock Text="LIGANAVN" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBox x:Name="LeagueNameBox" FontSize="14" TextChanged="LeagueNameBox_TextChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="DITT VISNINGSNAVN (VERT)" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBox x:Name="HostNameBox" FontSize="14" />
                    <TextBlock Text="Du er verten - kun du kan generere sesonger og gi straffer."
                               Foreground="{StaticResource MutedTextColor}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,26">
                <StackPanel>
                    <TextBlock Text="LMU RESULTS-MAPPE" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ResultsFolderBox" Grid.Column="0" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="Bla gjennom..." Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,8" Click="BrowseButton_Click" />
                    </Grid>
                    <TextBlock Text="Kjør løpene som vert - din fil inneholder hele feltet, uansett hvem som deltar."
                               Foreground="{StaticResource MutedTextColor}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Button x:Name="PrimaryButton" Content="Start liga" FontSize="15" Padding="0,15" Click="PrimaryButton_Click" />
            <Button Content="← Tilbake" Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0" Click="BackButton_Click" />
            <TextBlock x:Name="ErrorText" Text="" Foreground="{StaticResource DangerColor}" Margin="0,12,0,0"
                       TextWrapping="Wrap" HorizontalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
